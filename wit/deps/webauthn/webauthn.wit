package ohrats:rc-webauthn@0.1.0;

interface types {
    record challenge {
        id: string,
        challenge: list<u8>,
        relying-party-id: string,
        relying-party-name: string,
        user-id: list<u8>,
        user-name: string,
        timeout-ms: u32,
        algorithms: list<s32>,
    }

    record assertion {
        ceremony-id: string,
        credential-id: list<u8>,
        client-data-json: list<u8>,
        authenticator-data: list<u8>,
        signature: list<u8>,
        user-handle: option<list<u8>>,
    }

    record registration {
        ceremony-id: string,
        credential-id: list<u8>,
        client-data-json: list<u8>,
        attestation-object: list<u8>,
    }
}

interface ceremonies {
    use types.{assertion, challenge, registration};
    start-registration: func(display-name: string) -> result<challenge, string>;
    finish-registration: func(value: registration) -> result<string, string>;
    start-authentication: func() -> result<challenge, string>;
    finish-authentication: func(value: assertion) -> result<string, string>;
}
