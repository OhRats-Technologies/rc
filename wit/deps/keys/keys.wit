package ohrats:rc-keys@0.1.0;

interface types {
    enum key-algorithm {
        ed25519,
        x25519,
    }

    record public-key {
        algorithm: key-algorithm,
        bytes: list<u8>,
    }
}

/// Kernel-owned protected-key mechanism. Secret material never crosses WIT;
/// the resource is consumed only inside a component that imports this host
/// capability and is never forwarded through the component service registry.
interface host-custody {
    use types.{key-algorithm, public-key};

    resource shared-secret;

    resource session-key {
        encrypt: func(
            nonce: list<u8>,
            aad: list<u8>,
            plaintext: list<u8>,
        ) -> result<list<u8>, string>;
        decrypt: func(
            nonce: list<u8>,
            aad: list<u8>,
            ciphertext: list<u8>,
        ) -> result<list<u8>, string>;
    }

    resource secret-key {
        public-key: func() -> result<public-key, string>;
        sign: func(payload: list<u8>) -> result<list<u8>, string>;
        agree: func(peer-public: list<u8>) -> result<shared-secret, string>;
    }

    open: func(slot: string, algorithm: key-algorithm) -> result<option<secret-key>, string>;
    ensure: func(slot: string, algorithm: key-algorithm) -> result<secret-key, string>;
    generate: func(algorithm: key-algorithm) -> result<secret-key, string>;
    remove: func(slot: string, algorithm: key-algorithm) -> result<bool, string>;
    derive: func(
        first: borrow<shared-secret>,
        second: borrow<shared-secret>,
        salt: list<u8>,
        info: list<u8>,
    ) -> result<session-key, string>;
}

/// Component-facing custody service. Providers may use the local host vault or
/// another explicitly granted key backend. No secret resource crosses this ABI.
interface custody {
    use types.{key-algorithm, public-key};

    ensure: func(slot: string, algorithm: key-algorithm) -> result<public-key, string>;
    lookup: func(slot: string, algorithm: key-algorithm) -> result<option<public-key>, string>;
    sign: func(slot: string, algorithm: key-algorithm, payload: list<u8>) -> result<list<u8>, string>;
    remove: func(slot: string, algorithm: key-algorithm) -> result<bool, string>;
}
