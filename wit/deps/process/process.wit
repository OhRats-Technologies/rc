package ohrats:rc-process@0.2.0;

interface types {
    enum channel {
        control,
        ssh,
        mcp,
    }

    enum action {
        attach,
        input,
        close-input,
        resize,
        signal,
    }

    record principal {
        user-id: string,
        role: string,
        can-execute: bool,
        can-manage-devices: bool,
    }

    record terminal {
        cols: u16,
        rows: u16,
        term: string,
    }

    record start-request {
        process-id: string,
        command: string,
        cwd: string,
        terminal: option<terminal>,
        channel: channel,
        principal: principal,
    }

    record start-plan {
        command: string,
        cwd: string,
        terminal: option<terminal>,
        scrollback-bytes: u32,
        stdin-chunk-bytes: u32,
        authorization-timeout-ms: u32,
        terminate-grace-ms: u32,
    }

    record access-request {
        process-id: string,
        owner-user-id: string,
        action: action,
        principal: principal,
    }

    record resize-request {
        access: access-request,
        cols: u16,
        rows: u16,
    }

    record terminal-size {
        cols: u16,
        rows: u16,
    }

    record signal-request {
        access: access-request,
        signal: string,
    }
}

interface policy {
    use types.{
        access-request,
        resize-request,
        signal-request,
        start-plan,
        start-request,
        terminal-size,
    };

    authorize-start: func(request: start-request) -> result<start-plan, string>;
    authorize-access: func(request: access-request) -> result<_, string>;
    normalize-resize: func(request: resize-request) -> result<terminal-size, string>;
    normalize-signal: func(request: signal-request) -> result<string, string>;
}

/// Kernel-owned byte-stream resource used by component process managers.
/// Components never receive ambient file descriptors or arbitrary filesystem access.
interface stream-host {
    variant read-result {
        data(list<u8>),
        would-block,
        eof,
    }

    variant write-result {
        accepted(u32),
        would-block,
    }

    resource byte-stream {
        read: func(max-bytes: u32) -> result<read-result, string>;
        write: func(bytes: list<u8>) -> result<write-result, string>;
        close-write: func() -> result<_, string>;
        close: func(reason: string);
    }
}

/// Kernel-owned process handle. Product authorization and lifecycle policy stay in
/// components; this adapter performs only the already-approved OS operations.
interface process-host {
    use types.{terminal};
    use stream-host.{byte-stream};

    enum state {
        starting,
        running,
        exited,
        lost,
    }

    record spawn-request {
        process-id: string,
        command: string,
        args: list<string>,
        cwd: string,
        terminal: option<terminal>,
    }

    record spawned {
        process: own<process>,
        stdin: option<own<byte-stream>>,
        stdout: own<byte-stream>,
        stderr: option<own<byte-stream>>,
    }

    resource process {
        id: func() -> string;
        state: func() -> state;
        resize: func(cols: u16, rows: u16) -> result<_, string>;
        signal: func(signal: string) -> result<_, string>;
        terminate: func() -> result<_, string>;
        close: func();
    }

    spawn: func(request: spawn-request) -> result<spawned, string>;
}
