package ohrats:rc-webui@0.1.0;

interface types {
    record page {
        id: string,
        title: string,
        path: string,
        summary: string,
        content: string,
    }

    record public-document {
        title: string,
        body: string,
        scripts: list<string>,
        styles: list<string>,
        extra-head: string,
        indexable: bool,
    }
}

interface slots {
    use types.{page};
    register-page: func(value: page) -> result<_, string>;
    remove-page: func(id: string) -> result<bool, string>;
    pages: func() -> list<page>;
}

interface shell {
    use types.{public-document};
    render-public: func(value: public-document) -> string;
}
