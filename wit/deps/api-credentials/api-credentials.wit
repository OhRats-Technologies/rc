package ohrats:rc-api-credentials@0.1.0;

interface types {
    enum kind { api, cli }
    enum scope { read, execute, manage-devices, manage-workspaces }
    enum lifetime { never, one-hour, one-day, seven-days, thirty-days, ninety-days, one-eighty-days, one-year }

    record credential {
        id: string,
        user-id: string,
        kind: kind,
        name: string,
        public-key: string,
        scopes: list<scope>,
        created-at-ms: u64,
        expires-at-ms: u64,
        last-used-at-ms: option<u64>,
        revoked-at-ms: option<u64>,
    }

    record request {
        key-id: string,
        timestamp-seconds: string,
        nonce: string,
        method: string,
        path-and-raw-query: string,
        body: list<u8>,
        signature: string,
    }

    record verified {
        credential-id: string,
        user-id: string,
        kind: kind,
        scopes: list<scope>,
    }

    /// The HTTP adapter supplies this only after a browser session and fresh
    /// passkey step-up have been verified. The component rechecks freshness.
    record administrator {
        user-id: string,
        browser-client-id: string,
        passkey-step-up-at-ms: u64,
        now-ms: u64,
    }

    record cli-authorization {
        request-id: string,
        client-id: string,
        expires-at-ms: u64,
        interval-seconds: u32,
        verification-url: string,
    }
}

interface credentials {
    use types.{administrator, cli-authorization, credential, kind, lifetime, request, scope, verified};

    create-api: func(
        admin: administrator,
        id: string,
        name: string,
        public-key: string,
        scopes: list<scope>,
        lifetime: option<lifetime>,
    ) -> result<credential, string>;
    all: func(user-id: string) -> result<list<credential>, string>;
    get: func(id: string) -> result<option<credential>, string>;
    revoke: func(admin: administrator, id: string) -> result<bool, string>;
    verify: func(value: request, now-ms: u64) -> result<verified, string>;

    start-cli: func(
        client-id: string,
        public-key: string,
        lifetime: option<lifetime>,
        request-id: string,
        device-code: string,
        user-code: string,
        now-ms: u64,
    ) -> result<cli-authorization, string>;
    approve-cli: func(
        admin: administrator,
        request-id: string,
        user-code: string,
        browser-public-key: string,
    ) -> result<credential, string>;
    poll-cli: func(request-id: string, device-code: string, now-ms: u64) -> result<option<credential>, string>;
    revoke-cli: func(admin: administrator, id: string) -> result<bool, string>;
}
