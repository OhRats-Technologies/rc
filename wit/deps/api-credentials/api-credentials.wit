package ohrats:rc-api-credentials@0.1.0;

interface types {
    enum kind { api, cli }
    enum scope { read, execute, manage-devices, manage-workspaces }
    enum lifetime { never, one-hour, one-day, seven-days, thirty-days, ninety-days, one-eighty-days, one-year }

    record credential {
        id: string,
        user-id: string,
        kind: kind,
        name: string,
        public-key: string,
        scopes: list<scope>,
        created-at-ms: u64,
        expires-at-ms: u64,
        last-used-at-ms: option<u64>,
        revoked-at-ms: option<u64>,
    }

    record request {
        key-id: string,
        timestamp-seconds: string,
        nonce: string,
        method: string,
        path-and-raw-query: string,
        body: list<u8>,
        signature: string,
    }

    record verified {
        credential-id: string,
        user-id: string,
        kind: kind,
        scopes: list<scope>,
    }

    record cli-authorization {
        request-id: string,
        client-id: string,
        expires-at-ms: u64,
        interval-seconds: u32,
        verification-url: string,
    }
}

interface credentials {
    use types.{cli-authorization, credential, kind, lifetime, request, scope, verified};
    use ohrats:rc-identity/types@0.1.0.{human-authorization};

    create-api: func(
        admin: human-authorization,
        id: string,
        name: string,
        public-key: string,
        scopes: list<scope>,
        lifetime: option<lifetime>,
    ) -> result<credential, string>;
    all: func(user-id: string) -> result<list<credential>, string>;
    get: func(id: string) -> result<option<credential>, string>;
    revoke: func(admin: human-authorization, id: string) -> result<bool, string>;
    verify: func(value: request, now-ms: u64) -> result<verified, string>;

    start-cli: func(
        client-id: string,
        public-key: string,
        lifetime: option<lifetime>,
        request-id: string,
        device-code: string,
        user-code: string,
        now-ms: u64,
    ) -> result<cli-authorization, string>;
    approve-cli: func(
        admin: human-authorization,
        request-id: string,
        user-code: string,
        browser-public-key: string,
    ) -> result<credential, string>;
    poll-cli: func(request-id: string, device-code: string, now-ms: u64) -> result<option<credential>, string>;
    revoke-cli: func(admin: human-authorization, id: string) -> result<bool, string>;
}
