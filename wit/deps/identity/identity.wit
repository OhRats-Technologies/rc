package ohrats:rc-identity@0.1.0;

interface types {
    record user {
        id: string,
        display-name: string,
        created-at-ms: u64,
    }

    record ceremony {
        id: string,
        kind: string,
        user-id: option<string>,
        metadata: list<u8>,
        state: list<u8>,
        expires-at-ms: u64,
    }

    /// A random, short-lived capability. Identity stores only its digest and
    /// accepts it exactly once for the operation bound during step-up.
    record human-authorization {
        token: list<u8>,
    }
}

interface users {
    use types.{user};

    create: func(id: string, display-name: string) -> result<user, string>;
    get: func(id: string) -> result<option<user>, string>;
    all: func() -> result<list<user>, string>;
    count: func() -> result<u64, string>;
    rename: func(id: string, display-name: string) -> result<user, string>;
}

interface credentials {
    use types.{user};
    use ohrats:rc-webauthn/types@0.1.0.{stored-credential};

    record passkey {
        id: string,
        user-id: string,
        name: string,
        credential: stored-credential,
        created-at-ms: u64,
        last-used-at-ms: option<u64>,
    }

    create-user: func(
        user-id: string,
        display-name: string,
        passkey-name: string,
        credential: stored-credential,
    ) -> result<user, string>;
    add: func(
        user-id: string,
        name: string,
        credential: stored-credential,
    ) -> result<passkey, string>;
    get-by-credential-id: func(id: list<u8>) -> result<option<passkey>, string>;
    all: func(user-id: option<string>) -> result<list<passkey>, string>;
    update: func(id: string, credential: stored-credential, used-at-ms: u64) -> result<passkey, string>;
    remove: func(id: string, user-id: string) -> result<bool, string>;
}

interface ceremonies {
    use types.{ceremony};

    put: func(value: ceremony) -> result<_, string>;
    take: func(id: string, kind: string) -> result<option<ceremony>, string>;
}

interface admin-issuer {
    use types.{human-authorization};
    use ohrats:rc-webauthn/types@0.1.0.{authentication-request, relying-party};

    record challenge {
        id: string,
        challenge: list<u8>,
        relying-party: relying-party,
        credential-ids: list<list<u8>>,
    }

    begin: func(
        session-cookie: string,
        browser-client-id: string,
        operation: string,
        relying-party: relying-party,
    ) -> result<challenge, string>;

    /// Identity consumes the one-use ceremony, replaces caller credential material
    /// with its stored key, and invokes the typed WebAuthn verifier itself.
    issue: func(
        session-cookie: string,
        browser-client-id: string,
        challenge-id: string,
        authentication: authentication-request,
    ) -> result<human-authorization, string>;
}

interface admin-consumer {
    use types.{human-authorization};

    record claim {
        user-id: string,
        browser-client-id: string,
        issued-at-ms: u64,
        consumed-at-ms: u64,
        expires-at-ms: u64,
    }

    /// Consumes the sealed token exactly once and returns a bounded identity-owned claim.
    consume: func(
        authorization: human-authorization,
        operation: string,
    ) -> result<claim, string>;
}
