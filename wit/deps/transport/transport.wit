package ohrats:rc-transport@0.2.0;

interface types {
    enum ice-mode {
        host,
        stun,
        relay,
    }

    record ice-server {
        urls: list<string>,
        username: string,
        credential: string,
    }

    record answer-request {
        mode: ice-mode,
        ice-servers: list<ice-server>,
    }

    record answer-plan {
        ice-servers: list<ice-server>,
        gather-timeout-ms: u32,
        connect-timeout-ms: u32,
    }

    record attempt {
        mode: ice-mode,
        route: route-class,
        gather-timeout-ms: u32,
        connect-timeout-ms: u32,
        retry-delay-ms: u32,
    }

    enum route-class {
        direct-host,
        direct-stun,
        turn-relay,
        unknown,
    }

}

interface provider {
    use types.{answer-plan, answer-request, attempt, ice-server};

    plan-attempts: func(
        transport: string,
        ice-servers: list<ice-server>,
    ) -> result<list<attempt>, string>;

    plan-answer: func(
        transport: string,
        request: answer-request,
    ) -> result<answer-plan, string>;
}
