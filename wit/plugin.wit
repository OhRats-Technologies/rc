package ohrats:rc-plugin@0.1.0;

interface types {
    enum selection {
        single,
        keyed,
    }

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    record service {
        name: string,
        version: string,
        priority: s32,
        keys: list<string>,
    }

    record requirement {
        name: string,
        version: string,
        selection: selection,
    }

    record command {
        name: string,
        summary: string,
        usage: string,
    }

    record descriptor {
        id: string,
        version: string,
        provides: list<service>,
        requires: list<requirement>,
        commands: list<command>,
    }
}

interface host {
    use types.{log-level};
    log: func(level: log-level, message: string);
}
interface call-context {
    caller-component-id: func() -> option<string>;
}
interface component-store {
    record installed-component {
        name: string,
        id: string,
        version: string,
        digest: string,
        managed: bool,
    }

    installed: func() -> result<list<installed-component>, string>;
    install: func(
        name: string,
        artifact: list<u8>,
        expected-digest: option<string>,
    ) -> result<installed-component, string>;
    remove: func(name: string) -> result<bool, string>;
}

interface artifact-cache {
    read: func(digest: string) -> result<option<list<u8>>, string>;
    write: func(digest: string, artifact: list<u8>) -> result<_, string>;
}

interface state-store {
    read: func(name: string) -> result<option<list<u8>>, string>;
    write: func(name: string, value: list<u8>) -> result<_, string>;
    remove: func(name: string) -> result<bool, string>;
}

interface local-files {
    read: func(path: string) -> result<list<u8>, string>;
}

interface catalog-store {
    read: func(namespace: string) -> result<option<list<u8>>, string>;
}

interface service-registry {
    record provider {
        component-id: string,
        version: string,
        priority: s32,
        keys: list<string>,
    }

    providers: func(name: string, version: string) -> result<list<provider>, string>;
}

interface http-client {
    record header {
        name: string,
        value: string,
    }

    record request {
        method: string,
        url: string,
        headers: list<header>,
        body: list<u8>,
        max-response-bytes: u64,
    }

    record response {
        status: u16,
        final-url: string,
        headers: list<header>,
        body: list<u8>,
    }

    send: func(request: request) -> result<response, string>;
}

interface package-source {
    record package-artifact {
        name: string,
        source: string,
        digest: string,
        bytes: list<u8>,
    }

    resolve: func(scheme: string, spec: string) -> result<package-artifact, string>;
}

interface greeter {
    greet: func(name: string) -> string;
}
world plugin {
    use types.{descriptor};
    import host;
    import call-context;

    export descriptor: func() -> descriptor;
    export activate: func() -> result<_, string>;
    export deactivate: func();
    export invoke: func(command: string, args: list<string>) -> result<u32, string>;
}

world greeter-provider {
    include plugin;
    export greeter;
}

world greeter-consumer {
    include plugin;
    import greeter;
}

world kernel-plugin {
    include plugin;
    import component-store;
    import artifact-cache;
    import state-store;
    import local-files;
    import catalog-store;
    import service-registry;
    import http-client;
    import ohrats:rc-storage/durable-store@0.1.0;
}

world package-manager {
    include plugin;
    import component-store;
    import artifact-cache;
    import state-store;
    import catalog-store;
    import service-registry;
    import package-source;
}

