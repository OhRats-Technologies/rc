{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc.ohrats.party/schemas/component-v1.json",
  "title": "RC component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "build"],
  "properties": {
    "schema": { "const": 1 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "world", "wit"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._/-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "world": { "type": "string", "minLength": 1 },
        "wit": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "uniqueItems": true
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "package", "artifact"],
      "properties": {
        "kind": { "enum": ["rust"] },
        "package": { "type": "string", "minLength": 1 },
        "artifact": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  }
}
