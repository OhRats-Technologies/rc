{
  "name": "rc",
  "private": true,
  "version": "0.8.3",
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --hot server.ts",
    "build:client": "rm -rf dist/assets && bun build --target=browser --production --splitting --public-path=/assets/ --outdir=dist/assets --entry-naming='[name]-[hash].[ext]' --chunk-naming='chunk-[hash].[ext]' --asset-naming='[name]-[hash].[ext]' ./web/client/auth.ts ./web/client/account.ts ./web/client/api-page.ts ./web/client/action-run.ts ./web/client/authority.ts ./web/client/cli-authorize.ts ./web/client/live.ts ./web/client/device.ts ./web/client/process-terminal.ts ./web/client/copy.ts ./web/client/sidebar.ts ./web/styles.css ./web/social-card.png",
    "build:server": "rm -rf dist/server && bun build --target=bun --production --outdir=dist/server ./server.ts",
    "build": "rm -rf dist && bun run build:client && bun run build:server",
    "start": "bun server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke:webview": "bun scripts/webview-smoke.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@elysia/openapi": "^1.4.15",
    "@simplewebauthn/server": "^13.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "elysia": "^1.4.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "latest"
  }
}
