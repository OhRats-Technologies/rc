{
  "name": "relay",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "rm -rf dist && bun build --target=bun --production --public-path=/assets/ --outdir=dist ./server.ts",
    "start": "bun server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@simplewebauthn/server": "^13.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "elysia": "^1.4.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "latest"
  }
}
