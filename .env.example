# HTTP listener and externally visible WebAuthn origin.
PORT=3000
PUBLIC_URL=http://localhost:3000

# Go server data directory, database, and browser assets.
RC_DATA_DIR=./data
# RC_DB_PATH=./data/rc.db
RC_ASSETS_DIR=./dist/assets

# Set an explicit high-entropy value in production, then open /setup/<value>.
RC_SETUP_TOKEN=replace-with-at-least-32-random-bytes

# Trust sanitized forwarding headers only behind a controlled reverse proxy.
RC_TRUST_PROXY=0

# Public signup requires all three settings. Keep it disabled until Turnstile
# site and secret keys are configured.
RC_PUBLIC_SIGNUP=0
# RC_TURNSTILE_SITE_KEY=
# RC_TURNSTILE_SECRET_KEY=

# Optional Cloudflare TURN credentials for Node/browser ICE. Only short-lived
# ICE credentials are returned to clients.
# RC_CF_TURN_TOKEN_ID=
# RC_CF_TURN_API_TOKEN=
