# HTTP listener and externally visible WebAuthn origin.
PORT=3000
PUBLIC_URL=http://localhost:3000

# Rust v0.16 data and browser assets.
DATA_DIR=./data-v2
# RC_DB_PATH=./data-v2/rc-v2.sqlite3
STATIC_DIR=./dist/assets

# Set an explicit high-entropy value in production, then open /setup/<value>.
RC_SETUP_TOKEN=replace-with-at-least-32-random-bytes

# Trust CF-Connecting-IP / X-Forwarded-For only behind a controlled proxy.
RC_TRUST_PROXY=0

# Public signup remains disabled unless all three settings are configured.
RC_PUBLIC_SIGNUP=0
# RC_TURNSTILE_SITE_KEY=
# RC_TURNSTILE_SECRET_KEY=

# Optional Cloudflare TURN credentials for NAT traversal.
# RC_CF_TURN_TOKEN_ID=
# RC_CF_TURN_API_TOKEN=

# Internal SSH gateway ports. Only PORT normally needs external exposure.
RC_SSH_DAEMON_PORT=2222
RC_SSH_INTERNAL_PORT=3001

# OAuth access-token lifetime for MCP clients.
RC_MCP_ACCESS_TTL_MINUTES=15

# Completed execution metadata is not retained unless explicitly enabled.
RC_EXECUTION_HISTORY=none
RC_EXECUTION_HISTORY_TTL_HOURS=168

# Tracing filter.
RUST_LOG=rc_server=info,tower_http=info
